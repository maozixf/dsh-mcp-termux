{
  "name": "dsh-mcp-termux",
  "version": "1.1.0",
  "description": "MCP Termux（73 个 Android 逆向工具）的 DSH 插件：随 DSH 部署、启动、停止，卸载时全量清理；需 aarch64 + root。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "reverse-engineering",
    "android",
    "frida",
    "radare2"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "scripts",
    "locale",
    "deploy",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
